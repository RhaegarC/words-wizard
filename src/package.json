{
  "name": "words-wizard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "extract:wordlist": "node page/scripts/extract-wordlist.mjs",
    "build": "vite build",
    "check:dist": "node page/scripts/check-dist.mjs",
    "check:deploy": "node page/scripts/check-deploy.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:remote": "vitest run worker/test/remote.test.ts",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:typecheck": "tsc --noEmit -p tsconfig.worker.json",
    "typecheck": "tsc --noEmit -p tsconfig.page.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.worker.json",
    "format": "oxfmt ."
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "hono": "^4.13.14",
    "jose": "^6.2.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "oxfmt": "^0.2.0",
    "pdf-parse": "1.1.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^8.0.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.155.0"
  }
}
