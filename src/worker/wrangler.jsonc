{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "words-wizard-api",
  "main": "index.ts",
  "compatibility_date": "2025-01-01",
  "vars": {
    "JWKS_URL": "https://login.microsoftonline.com/3f18e889-b0e4-41ae-ad36-7d2f73d416ff/discovery/v2.0/keys",
    "TOKEN_ISSUER": "https://login.microsoftonline.com/3f18e889-b0e4-41ae-ad36-7d2f73d416ff/v2.0",
    "EXPECTED_AUDIENCE": "2fc2ab8a-4a9b-40b2-a4fa-a8a95fb7b969",
    "EXPECTED_TENANT": "3f18e889-b0e4-41ae-ad36-7d2f73d416ff",
    "ALLOWED_ORIGINS": "https://words.nioh.uk,http://localhost:8443"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "words-wizard",
      "database_id": "66f18da9-7155-4306-ac09-8fba93fc3a1b",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "words-wizard-avatars"
    }
  ],
  "routes": [{ "pattern": "wordsapi.nioh.uk", "custom_domain": true }]
}
