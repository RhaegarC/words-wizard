# Copy to .env for local development. These are public build-time values, not
# secrets. The Worker reads its matching values from worker/wrangler.jsonc.
# `common` accepts any Entra tenant and personal Microsoft accounts; use the
# home tenant id instead to restrict sign-in to one tenant.
VITE_ENTRA_CLIENT_ID=REPLACE_WITH_SPA_CLIENT_ID
VITE_ENTRA_TENANT_ID=common
# The admin portal only (single-tenant): the home tenant id, a GUID. The portal
# refuses `common`, so a personal or other-tenant account cannot sign in there.
VITE_PORTAL_ENTRA_TENANT_ID=REPLACE_WITH_HOME_TENANT_ID
VITE_ENTRA_SCOPE=api://REPLACE_WITH_SPA_CLIENT_ID/access_as_user
VITE_API_BASE_URL=http://localhost:8787
# Optional. Unset means <VITE_API_BASE_URL>/v1/avatars.
# VITE_AVATAR_BASE_URL=https://avatars.nioh.uk
